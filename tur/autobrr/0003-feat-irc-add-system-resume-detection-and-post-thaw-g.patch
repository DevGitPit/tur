 // recordSessionEndLocked records one registered session and reports whether the
 // flapping threshold was reached. The caller must hold h.m.
 func (h *Handler) recordSessionEndLocked(lifetime time.Duration, endedAt time.Time) bool {
+	if !h.excludeFlappingUntil.IsZero() && endedAt.Before(h.excludeFlappingUntil) {
+		h.log.Debug().Time("ended_at", endedAt).Time("exclude_until", h.excludeFlappingUntil).Msg("session end excluded from flapping breaker due to resume grace period")
+		return false
+	}
+
 	if lifetime >= flappingSessionMinLifetime {
 		h.resetFlappingBreakerLocked()
 		return false
@@ -919,6 +926,44 @@ func (h *Handler) clearConnectErrorLocked(substr string) {
 	h.connectionErrors = filtered
 }
 
+func (h *Handler) OnSystemResume(freezeStart, excludeUntil time.Time) {
+	h.m.Lock()
+	h.excludeFlappingUntil = excludeUntil
+	client := h.client
+	isLive := h.clientState == ircLive
+	h.m.Unlock()
+
+	h.log.Info().
+		Time("freeze_start", freezeStart).
+		Time("exclude_until", excludeUntil).
+		Msg("handling system resume; session drops during grace period will be excluded from flapping")
+
+	if isLive && client != nil {
+		go h.probeLiveConnectionAfterResume(client)
+	}
+}
+
+func (h *Handler) probeLiveConnectionAfterResume(client *ircevent.Connection) {
+	time.Sleep(2 * time.Second)
+
+	h.m.RLock()
+	stillSameClient := h.client == client && h.clientState == ircLive
+	h.m.RUnlock()
+	if !stillSameClient {
+		return
+	}
+
+	pingErr := client.Send("PING autobrr-probe")
+	if pingErr != nil {
+		h.log.Warn().Err(pingErr).Msg("resume socket probe failed; disconnecting dead socket")
+		h.m.Lock()
+		if h.client == client {
+			h.client.Quit()
+		}
+		h.m.Unlock()
+	}
+}
