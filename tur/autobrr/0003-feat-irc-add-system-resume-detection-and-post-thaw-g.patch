+++ b/internal/irc/health_monitor.go
@@ -124,6 +124,35 @@ func (s *Service) monitorHealth(ctx context.Context) {
 	}
 }
 
+func (s *Service) watchResume(ctx context.Context) {
+	const tick = 5 * time.Second
+	const gapThreshold = 15 * time.Second
+
+	last := time.Now().Round(0)
+	ticker := time.NewTicker(tick)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case now := <-ticker.C:
+			wall := now.Round(0)
+			gap := wall.Sub(last)
+			if gap >= gapThreshold {
+				s.log.Warn().Dur("gap", gap).Msg("system suspend/thaw detected; notifying IRC handlers")
+				freezeStart := wall.Add(-gap)
+				excludeUntil := wall.Add(postThawGracePeriod)
+
+				for _, handler := range s.networkHandlers.Iterator() {
+					handler.OnSystemResume(freezeStart, excludeUntil)
+				}
+			}
+			last = wall
+		}
+	}
+}
